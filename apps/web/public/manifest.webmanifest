{
  "name": "Skypier dM",
  "short_name": "SkypierChat",
  "description": "Privacy-first peer-to-peer messaging over libp2p.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#08111f",
  "theme_color": "#08111f",
  "categories": ["communication", "social"],
  "icons": [
    {
      "src": "/icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screenshot-portrait-1080x1920.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Skypier chat thread on mobile"
    },
    {
      "src": "/screenshots/screenshot-landscape-1920x1080.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Skypier chat interface on desktop"
    }
  ]
,
  "protocol_handlers": [
    {
      "protocol":"web+skypierchat",
      "url":"/chats"
    }
  ]
}
